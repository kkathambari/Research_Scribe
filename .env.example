# ResearchScribe Environment Configuration

# -------------------------------------------------------------
# LLM Provider Configuration (FR-01, FR-02, FR-03, FR-08)
# -------------------------------------------------------------
# Supported values: "ollama" (default local), "gemini" (cloud), "heuristic" (offline mock)
LLM_PROVIDER=ollama

# Local Ollama Configuration
# In Docker Compose, use: http://ollama:11434
# For host-installed Ollama, use: http://localhost:11434 (or host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Recommended Models by Hardware Capacity:
# 1. Resource-constrained (8GB RAM / CPU):
#    - deepseek-coder:latest (1.3B params, ~776MB download, ~1.5GB runtime RAM)
#    - gemma2:2b (2B params, ~1.6GB download, ~2.5GB runtime RAM)
# 2. Balanced (16GB RAM or 6GB+ VRAM):
#    - mistral:latest (7B params, ~4.1GB download, ~5.5GB runtime RAM)
#    - llama3:latest (8B params, ~4.7GB download, ~6GB runtime RAM)
# 3. High performance (32GB+ RAM or 12GB+ VRAM):
#    - qwen2.5:14b or llama3.1:8b
OLLAMA_MODEL=deepseek-coder:latest

# Request Timeout (seconds)
OLLAMA_TIMEOUT=60.0
OLLAMA_KEEP_ALIVE=5m

# -------------------------------------------------------------
# Optional Cloud Provider: Google Gemini
# -------------------------------------------------------------
# Leave empty when using local Ollama (AC-01)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=45.0

# -------------------------------------------------------------
# Fallback Policy (FR-08, AC-11, AC-12)
# -------------------------------------------------------------
# Controls fallback when the primary LLM provider fails.
# Options: "none" (strict local - no external calls), "heuristic", "gemini"
# IMPORTANT: "none" guarantees that prompts are NEVER sent to Gemini without authorization.
LLM_FALLBACK_PROVIDER=none
LLM_MAX_RETRIES=2

# -------------------------------------------------------------
# Storage & Database Paths
# -------------------------------------------------------------
DATABASE_URL=sqlite:///./researchscribe.db
